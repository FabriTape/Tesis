 # Init

variable data index 1


variable xrotate index 1
variable yrotate index 1
variable zrotate index 1
variable angle index 1


variable xmove index 1
variable ymove index 1
variable zmove index 1


variable velocity index 1
variable nsteps index 1
variable ndumps index 1
variable nthermo index 1

variable proc_x index 1
variable proc_y index 1
variable proc_z index 1

variable timestep index 1
variable z_filtro index 1
variable v2_min index 1
variable v2_max index 1
variable n_max index 1
variable umbral_xy index 1

variable young_modulus index 1
variable poisson index 1
variable surface_energy index 1
variable density_proj index 1

variable nloops equal ceil(${nsteps}/10000.0)
variable a loop ${nloops}

#limites de la caja

variable x_max equal xhi
variable y_max equal yhi


newton off


units       si
dimension   3
boundary    p p f
atom_style  sphere
neighbor  100e-9 bin
comm_modify mode single vel yes cutoff 5e-6
processors ${proc_x} ${proc_y} ${proc_z}




# Atom definition
read_data ${data}
#read_data ./box_fill_0.35_SI.data

#TODO: EDITAR TAMAÑO DE CAJA EN DATA y NUMERO DE GRANOS a 2

change_box all z final -1e-5 0.000410
#TODO: GRANOS EN POSICION original con centro de la caja en 0 0 0

#1 1 1.52e-6 2000 0.76e-6 0 0
#2 1 1.52e-6 2000 -0.76e-6 0 0
#3 1 1.52e-6 2000 0 1.32e-6 0

##### crea granos del proyectil

#create_atoms 2 single 73.26e-6 72.5e-6 152e-6
#create_atoms 2 single 71.74e-6 72.5e-6 152e-6
#create_atoms 2 single 72.5e-6 73.82e-6 152e-6


#NP1
#create_atoms 2 single 50e-5 50e-5 105e-5
#create_atoms 2 single 5e-5 5e-5 10.3e-5
#create_atoms 2 single 72.5e-6 72.5e-6 152e-6


#NP3
#create_atoms 2 single 73.26e-6 72.5e-6 152e-6
#create_atoms 2 single 71.74e-6 72.5e-6 152e-6
#create_atoms 2 single 72.5e-6 73.816e-6 152e-6
#Esto lo pongo para que las 3 particulas queden en el centro
create_atoms 2 single 50.76e-6 50e-6 152e-6
create_atoms 2 single 49.24e-6 50e-6 152e-6
create_atoms 2 single 50e-6 51.316e-6 152e-6

set type 2 diameter 1.52e-6
set type 2 density ${density_proj}

# Groups
group bloque type 1
group sphere type 2

#TODO: CUIDADO CON EL CENTRO DE LA ROTACION, SI CAMBIA EL TAMAÑO DE LA CAJA HAY Q CAMBIAR EL CENTRO
#displace_atoms sphere rotate 72.5e-6 72.5e-6 152e-6 ${xrotate} ${yrotate} ${zrotate} ${angle}
displace_atoms sphere rotate 50e-6 50e-6 152e-6 ${xrotate} ${yrotate} ${zrotate} ${angle}
displace_atoms sphere move ${xmove} ${ymove} ${zmove}


write_data pre-run_with_projectile.data


#Settings
#pair_style gran/easy 2.7e10 0.17 0.5e-9 0.025 0.1e-9 0.736e-5  #you have to modify the values for your implementation
pair_style granular
pair_coeff * * jkr ${young_modulus} 1.0e16 ${poisson} ${surface_energy} tangential mindlin NULL 1 0.5 rolling sds 5e09 9.895e-09 0.1 twisting marshall

timestep ${timestep}

# fixes & compute
fix 1 bloque nve/sphere
fix 2 sphere nve/sphere

compute 1 all ke/atom

velocity bloque create 10.0 83921
velocity sphere set 0.0 0.0 ${velocity} units box


thermo ${nthermo}
thermo_modify lost warn

# Dump de aire: partículas por encima del filtro (aire + congeladas)
variable es_aire atom "(z > v_z_filtro) && (type == 1)"
dump 1 all custom ${ndumps} output_aire.*.%.txt id type x y z vx vy vz omegax omegay omegaz
dump_modify 1 thresh v_es_aire == 1

# Dump de cama: partículas de cama (z <= z_filtro)
variable es_cama atom "(z <= v_z_filtro) && (type == 1)"
dump 2 all custom ${ndumps} output_cama.*.%.txt id type x y z vx vy vz omegax omegay omegaz
dump_modify 2 thresh v_es_cama == 1

# ==========================================================
# DETECTOR DE ONDA (solo para simulaciones críticas)
# ==========================================================

variable vel_num equal ${velocity}
variable xm_num equal ${xmove}
variable ym_num equal ${ymove}
variable zm_num equal ${zmove}
variable move_max equal "abs(v_xm_num) + abs(v_ym_num) + abs(v_zm_num)"
variable is_critical equal "(v_vel_num == -50) && (v_move_max > 0)"

if "${is_critical} == 1" then &
    "variable v2_wave atom '(vx*vx)+(vy*vy)+(vz*vz)'" &
    "variable is_wave atom '(type == 1) && (v_v2_wave > v_v2_min) && (z <= v_z_filtro) && ((x < v_umbral_xy) || (x > (v_x_max - v_umbral_xy)) || (y < v_umbral_xy) || (y > (v_y_max - v_umbral_xy)))'" &
    "compute n_wave all reduce sum v_is_wave" &
    "variable stop_cond equal '(c_n_wave > v_n_max) && (step > 50000)'" &
    "fix wave_trigger all halt 25000 v_stop_cond > 0"

# ----------------------------------------------------------
# LANZAMIENTO DEL IMPACTO + TRAMPA
# El loop corre exactamente nsteps pasos en bloques de 10000
# Cada iteración congela partículas que superan 250 um
# Si el halt de onda se activó, el run se corta antes de 10000 pasos
# ----------------------------------------------------------
label trampa
    variable step_before equal step
    region r_trampa block INF INF INF INF 2.5e-4 INF
    group  gr_trampa region r_trampa
    velocity gr_trampa set 0.0 0.0 0.0
    run    10000
    region r_trampa delete
    group  gr_trampa delete

    # Si el halt se activó, el run se cortó antes de los 10000 pasos
    variable step_after equal step
    variable delta_step equal "v_step_after - v_step_before"
    if "${delta_step} < 10000" then "jump SELF fin"
    next   a
    jump   SELF trampa
label fin
