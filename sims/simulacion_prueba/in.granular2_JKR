# Init
variable input index 1

# Ejemplo in.pour de lammps con unidades lj
#variable        rhi equal 0.5 #para LJ
#variable skin equal 0.4*${rhi} #para LJ

#newton off

dimension   3
boundary    s s s

atom_style  sphere
units       si

comm_modify     vel yes
neighbor        100e-9 bin
#neighbor        ${skin} bin
neigh_modify    delay 0 every 1 check yes


#comm_modify mode single vel yes
processors * * *

# Atom definition
read_data ${input}
#read_dump ${input}

# Groups
group g1 type 1  
group g2 type 2

#Settings                      

### LAS SIGUIENTES DOS LINEAS SON LAS QUE TENDRIAS QUE COMENTAR en tu script:
#pair_style gran/easy 2.7e10 0.17 0.5e-9 0.025 0.1e-9 0.736e-5  #you have to modify the values for your implementation
#pair_coeff * *

### ESTAS dos lineas son las que tendrias que tener en tu script para usar el modelo JKR:
pair_style granular 
pair_coeff * * jkr 54.0e09 1.0e16 0.17 0.025 tangential mindlin NULL 1 0.5 rolling sds 5e09 9.895e-09 0.1 twisting marshall

timestep 5e-11   

# fixes & compute
fix 1 g1 nve/sphere
fix 2 g2 nve/sphere

#velocity g1 set 0.0 0.0 0.0 units box
#velocity g2 set 0.0 0.0 0.0 units box

#dump 1 all custom 1000 out/pre_output.*.gz id type x y z vx vy vz omegax omegay omegaz

#fix 3 all viscous 1e-6 
#compute 1 all ke/atom
#compute 2 all coord/atom 1.7e-6

thermo 1000
#run 50000

#reset_timestep 0 

#velocity bloque create 10.0 83921
velocity g1 create 0.00001 83921

#Se separan
#velocity g1 set 0.0 0.0 0.0859 units box
velocity g2 set 0.0 0.0 -100 units box


#velocity g1 set 0.0 0.0 0.086 units box
#velocity g2 set 0.0 0.0 -0.086 units box
 #dump 2 all custom 10000 output.*.gz id type x y z vx vy vz omegax omegay omegaz

dump 1 all custom 10000 output.*.gz id type x y z vx vy vz omegax omegay omegaz
dump_modify 1 format line "%d %d %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g"

run 500000 upto
