LAMMPS (29 Sep 2021 - Update 1)
# Init
variable data index 1

variable xrotate index 1
variable yrotate index 1
variable zrotate index 1
variable angle index 1

variable xmove index 1
variable ymove index 1
variable zmove index 1

variable velocity index 1
variable nsteps index 1
variable ndumps index 1
variable nthermo index 1


newton off

units       si
dimension   3
boundary    p p f
atom_style  sphere
neighbor  100e-9 bin
comm_modify mode single vel yes
processors * * *



# Atom definition
read_data ${data}
read_data ../box_fill_0.35_SI.data
Reading data file ...
  orthogonal box = (0.0000000 0.0000000 0.0000000) to (0.00010000000 0.00010000000 0.00010000000)
  2 by 4 by 4 MPI processor grid
  reading atoms ...
  190343 atoms
  read_data CPU = 0.704 seconds
#read_data ./box_fill_0.35_SI.data

#TODO: EDITAR TAMAÑO DE CAJA EN DATA y NUMERO DE GRANOS a 2
change_box all z final -1e-5 0.000410
Changing box ...
  orthogonal box = (0.0000000 0.0000000 -1.0000000e-05) to (0.00010000000 0.00010000000 0.00041000000)

#TODO: GRANOS EN POSICION original con centro de la caja en 0 0 0
#1 1 1.52e-6 2000 0.76e-6 0 0
#2 1 1.52e-6 2000 -0.76e-6 0 0
#3 1 1.52e-6 2000 0 1.32e-6 0
##### crea granos del proyectil
#create_atoms 2 single 73.26e-6 72.5e-6 152e-6
#create_atoms 2 single 71.74e-6 72.5e-6 152e-6
#create_atoms 2 single 72.5e-6 73.82e-6 152e-6

#NP1
#create_atoms 2 single 50e-5 50e-5 105e-5
create_atoms 2 single 5e-5 5e-5 10.3e-5
Created 1 atoms
  using lattice units in orthogonal box = (0.0000000 0.0000000 -1.0000000e-05) to (0.00010000000 0.00010000000 0.00041000000)
  create_atoms CPU = 0.000 seconds
#create_atoms 2 single 72.5e-6 72.5e-6 152e-6

#NP3
#create_atoms 2 single 73.26e-6 72.5e-6 152e-6
#create_atoms 2 single 71.74e-6 72.5e-6 152e-6
#create_atoms 2 single 72.5e-6 73.816e-6 152e-6

set type 2 diameter 1.52e-6
Setting atom values ...
  1 settings made for diameter
set type 2 density 2.0e+03
Setting atom values ...
  1 settings made for density

# Groups
group bloque type 1
190343 atoms in group bloque
group sphere type 2
1 atoms in group sphere

#TODO: CUIDADO CON EL CENTRO DE LA ROTACION, SI CAMBIA EL TAMAÑO DE LA CAJA HAY Q CAMBIAR EL CENTRO
#displace_atoms sphere rotate 72.5e-6 72.5e-6 152e-6 ${xrotate} ${yrotate} ${zrotate} ${angle}
displace_atoms sphere move ${xmove} ${ymove} ${zmove}
displace_atoms sphere move 0e-6 ${ymove} ${zmove}
displace_atoms sphere move 0e-6 0e-6 ${zmove}
displace_atoms sphere move 0e-6 0e-6 0e-6
Displacing atoms ...


write_data pre-run_with_projectile.data
System init for write_data ...
WARNING: Communication cutoff is 0.0. No ghost atoms will be generated. Atoms may get lost. (../comm_brick.cpp:209)

#Settings
#pair_style gran/easy 2.7e10 0.17 0.5e-9 0.025 0.1e-9 0.736e-5  #you have to modify the values for your implementation
pair_style granular
pair_coeff * * jkr 70.0e09 1.0e16 0.17 0.025 tangential mindlin NULL 1 0.5 rolling sds 5e09 9.895e-09 0.1 twisting marshall
timestep 5e-11

# fixes & compute
fix 1 bloque nve/sphere
fix 2 sphere nve/sphere

compute 1 all ke/atom

velocity bloque create 10.0 83921
velocity sphere set 0.0 0.0 ${velocity} units box
velocity sphere set 0.0 0.0 -5 units box

dump 1 all custom ${ndumps} output.*.gz id type x y z vx vy vz omegax omegay omegaz c_1
dump 1 all custom 25000 output.*.gz id type x y z vx vy vz omegax omegay omegaz c_1
#dump_modify 1 format "%d %d %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g %2.16g"

thermo ${nthermo}
thermo 5000
#run 15000000 upto
thermo_modify lost warn

#run ${nsteps}

variable nloops equal ${nsteps}/10000
variable nloops equal 1000000/10000
variable a loop ${nloops}
variable a loop 100


label loop
	variable steps equal 10000
	region wallzup  block -1 1 -1 1 2.5e-4 1
	group bordesg region wallzup
0 atoms in group bordesg
	velocity bordesg set 0.0 0.0 0.0 units box

	run ${steps}
	run 10000
Neighbor list info ...
  update every 1 steps, delay 10 steps, check yes
